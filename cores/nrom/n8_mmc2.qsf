# n8-open: NROM core for the EverDrive N8 clone (Quartus II 13.0 SP1)
# Pin numbers: hardware facts, see docs/pinout.md
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name TOP_LEVEL_ENTITY n8_top
set_parameter -name RET_MENU 1
set_parameter -name MAPPER 9
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE n8_nrom.sdc
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name VERILOG_FILE osmap.v
set_global_assignment -name VERILOG_FILE map_nrom.v
set_global_assignment -name VERILOG_FILE map_mmc1.v
set_global_assignment -name VERILOG_FILE map_mmc3.v
set_global_assignment -name VERILOG_FILE map_mmc5.v
set_global_assignment -name VERILOG_FILE map_mmc2.v
set_global_assignment -name VERILOG_FILE mmc5_snd.v
set_global_assignment -name VERILOG_FILE map_simple.v
set_global_assignment -name VERILOG_FILE map_vrc6.v
set_global_assignment -name VERILOG_FILE map_fds.v
set_global_assignment -name VERILOG_FILE aud_dac.v
set_global_assignment -name VERILOG_FILE fds_snd.v

# configuration: passive serial from the MAX II, RBF output
set_global_assignment -name CYCLONEII_CONFIGURATION_SCHEME "PASSIVE SERIAL"
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# I/O
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85

# pins
set_location_assignment PIN_118 -to chr_ce
set_location_assignment PIN_1 -to chr_map[0]
set_location_assignment PIN_144 -to chr_map[1]
set_location_assignment PIN_143 -to chr_map[2]
set_location_assignment PIN_142 -to chr_map[3]
set_location_assignment PIN_141 -to chr_map[4]
set_location_assignment PIN_133 -to chr_map[5]
set_location_assignment PIN_132 -to chr_map[6]
set_location_assignment PIN_129 -to chr_map[7]
set_location_assignment PIN_126 -to chr_map[8]
set_location_assignment PIN_134 -to chr_oe
set_location_assignment PIN_125 -to chr_we
set_location_assignment PIN_17 -to clk
